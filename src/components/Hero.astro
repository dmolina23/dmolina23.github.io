      Contact me
    </a>
  </div>

  <!-- Imagen destacada -->
  <div class="mt-16 w-full max-w-4xl aspect-video rounded-2xl bg-slate-950/40 border border-slate-800/80 flex items-center justify-center relative overflow-hidden backdrop-blur-sm shadow-2xl shadow-black/50 group">
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent z-10"></div>
    
    <div class="absolute inset-0 flex items-center justify-center bg-slate-900/20 group-hover:scale-[1.02] transition-transform duration-500 p-4">
      <span class="text-xs sm:text-sm text-slate-400 z-20 bg-slate-950/90 px-4 py-2 rounded-full border border-slate-850/80 text-center max-w-xs sm:max-w-xl md:max-w-none">
