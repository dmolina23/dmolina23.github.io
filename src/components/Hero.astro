<section class="w-full max-w-5xl mx-auto px-6 py-12 md:py-20 text-center flex flex-col items-center">
  <span class="text-xs font-semibold tracking-widest text-cyan-500 uppercase bg-cyan-950/30 px-4 py-1.5 rounded-full border border-cyan-900/50 mb-6 text-center max-w-full">
    Open to new technical challenges
  </span>

  <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight leading-tight max-w-4xl">
    Building reliable web applications <br class="hidden sm:inline" />
    <span class="text-slate-500">that solve real-world problems.</span>
  </h1>
  
  <p class="mt-6 text-base sm:text-lg md:text-xl text-slate-400 max-w-2xl font-light leading-relaxed">
    Hello, I'm <strong class="text-white font-medium">David Molina</strong>. Software Developer. Based in Spain. <br class="hidden sm:inline" /> Constantly learning to shape the future.
  </p>
  
  <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center w-full sm:w-auto px-4 sm:px-0">
    <a 
      href="#projects" 
      class="text-sm font-semibold bg-white text-black px-8 py-3 rounded-full hover:bg-slate-200 transition-all duration-300 text-center"
    >
      See projects
    </a>
    <a 
      href="#work_together" 
      class="text-sm font-semibold bg-transparent border border-slate-700 text-white px-8 py-3 rounded-full hover:border-white transition-all duration-300 text-center"
