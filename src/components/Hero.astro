    <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent z-10"></div>
    
    <!-- Aquí puedes poner una captura de pantalla real de la web que acabamos de montar -->
    <div class="absolute inset-0 flex items-center justify-center bg-slate-900/20 group-hover:scale-[1.02] transition-transform duration-500">
      <span class="text-sm text-slate-500 z-20 bg-slate-950/80 px-4 py-2 rounded-full border border-slate-850">Actually working on: "Quantum-Classical Hybrid DeFi & Portfolio Rebalancing Engine"</span>
