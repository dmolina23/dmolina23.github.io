  <!-- Legal disclaimers or tiny subtext -->
  <div class="mt-12 text-[10px] text-slate-700 font-light max-w-4xl mx-auto text-left leading-relaxed">
    <p>This personal portfolio was built using Astro and Tailwind CSS. All rights regarding the projects displayed and research materials are reserved to their respective authors and academic bodies.</p>
  </div>
</footer>