<footer id="work_together" class="w-full max-w-5xl mx-auto px-6 py-24 text-center scroll-mt-24">
  <!-- Final Call to Action -->
  <div class="flex flex-col items-center py-12">
    <h3 class="text-3xl md:text-5xl font-extrabold tracking-tight max-w-2xl leading-tight">
      Let's build the perfect match <span class="text-slate-500">for your next project.</span>
    </h3>
    <p class="mt-4 text-slate-500 text-sm font-light tracking-wide max-w-lg leading-relaxed">
      Looking for a proactive Software Engineer who brings technical rigor, robust architecture, and design sensitivity to your team? Let's connect.
    </p>
    <div class="mt-8">
      <a 
        href="mailto:davidmoli1234@gmail.com" 
        class="inline-block text-sm font-semibold bg-white text-black px-8 py-3 rounded-full hover:bg-slate-200 transition-all duration-300 shadow-lg shadow-white/5"
      >
        Get in Touch via Email
      </a>
    </div>
  </div>

  <!-- Divider and Bottom Navigation -->
  <div class="mt-24 pt-8 border-t border-slate-900 flex flex-col md:flex-row items-center justify-between gap-6 text-xs text-slate-500 font-light">
    <div class="flex flex-wrap items-center gap-4 justify-center">
      <span>© {new Date().getFullYear()} David Molina Gámez. All rights reserved.</span>
    </div>
    
    <!-- Social Network Links (GitHub & LinkedIn) -->
    <div class="flex items-center gap-5">
      <!-- GitHub Icon -->
      <a 
        href="https://github.com/dmolina23" 
        target="_blank" 
        rel="noopener noreferrer"
        class="text-slate-500 hover:text-white transition-colors" 
