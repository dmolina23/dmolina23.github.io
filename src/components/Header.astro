---
---
<header class="w-full max-w-7xl mx-auto px-4 sm:px-6 py-6 flex items-center justify-between relative z-50">
  <div class="text-xl font-bold tracking-tight z-50">
    <a href="/" class="hover:text-cyan-400 transition-colors">ZetaLabs</a>
    <a href="/" class="ml-2 text-sm font-light text-slate-500 hover:text-slate-300 transition-colors">by <b>David Molina</b></a>
  </div>
  
  <!-- Botón de menú hamburguesa para móviles -->
  <button 
    id="menu-toggle" 
    class="md:hidden text-slate-400 hover:text-white focus:outline-none z-50 p-2" 
    aria-label="Toggle Menu"
  >
    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
    </svg>
  </button>

  <!-- Menú de navegación móvil y escritorio -->
  <nav 
    id="menu-items" 
    class="hidden md:flex items-center gap-6 absolute md:relative top-full left-0 right-0 md:top-auto md:left-auto md:right-auto bg-[#030712]/95 md:bg-transparent border-b border-slate-900 md:border-none p-6 md:p-0 flex-col md:flex-row shadow-xl md:shadow-none transition-all duration-300 rounded-b-2xl md:rounded-none z-40"
  >
    <a href="#about" class="text-sm font-medium text-slate-400 hover:text-white transition-colors w-full md:w-auto text-center py-2 md:py-0">About me</a>
    <a href="#projects" class="text-sm font-medium text-slate-400 hover:text-white transition-colors w-full md:w-auto text-center py-2 md:py-0">Projects</a>
    <a href="#experience" class="text-sm font-medium text-slate-400 hover:text-white transition-colors w-full md:w-auto text-center py-2 md:py-0">Experience</a>
    <a href="/pentest_blog/" class="text-sm font-medium text-slate-400 hover:text-white transition-colors w-full md:w-auto text-center py-2 md:py-0">Blog</a>
    <a 
      href="#work_together" 
      class="text-xs md:text-sm font-medium bg-[#0f172a] border border-slate-800 text-white px-4 py-2 rounded-full hover:bg-slate-900 transition-all duration-200 shadow-md shadow-black/40 w-fit text-center mt-2 md:mt-0"
    >
      Let's work together
    </a>
  </nav>
</header>

<script>
  const toggleBtn = document.getElementById('menu-toggle');
  const menuItems = document.getElementById('menu-items');
  const menuIcon = document.getElementById('menu-icon');

  if (toggleBtn && menuItems && menuIcon) {
    toggleBtn.addEventListener('click', () => {
      const isHidden = menuItems.classList.contains('hidden');
      if (isHidden) {
        menuItems.classList.remove('hidden');
        menuItems.classList.add('flex');
        // Icono cerrar (X)
        menuIcon.setAttribute('d', 'M6 18L18 6M6 6l12 12');
      } else {
        menuItems.classList.add('hidden');
        menuItems.classList.remove('flex');
        // Icono hamburguesa
        menuIcon.setAttribute('d', 'M4 6h16M4 12h16M4 18h16');
      }
    });

    // Cerrar el menú al hacer click en cualquier enlace (útil en móviles)
    const links = menuItems.querySelectorAll('a');
    links.forEach(link => {
      link.addEventListener('click', () => {
        if (window.innerWidth < 768) {
          menuItems.classList.add('hidden');
          menuItems.classList.remove('flex');
          menuIcon.setAttribute('d', 'M4 6h16M4 12h16M4 18h16');
        }
      });
    });
  }
</script>