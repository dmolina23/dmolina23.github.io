---
interface Props {
	title: string;
}

const { title } = Astro.props;

import '../styles/global.css';
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="FindMyRoomie - Encuentra tu compañero de piso perfecto" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
		<!-- Fuente Inter para emular el diseño de Figma -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
	</head>
	<body class="bg-[#030712] ml-7 text-white font-sans antialiased relative min-h-screen overflow-x-hidden selection:bg-cyan-500 selection:text-black">
		<!-- Efectos de Luces de Fondo (Ambient Glows) -->
		<div class="absolute top-[-10%] left-[-10%] w-[60%] h-[50%] bg-[#0e2c33]/40 blur-[140px] rounded-full -z-10 pointer-events-none"></div>
		<div class="absolute top-[40%] right-[-10%] w-[50%] h-[50%] bg-[#082025]/30 blur-[150px] rounded-full -z-10 pointer-events-none"></div>
		<div class="absolute bottom-[-5%] left-[10%] w-[60%] h-[50%] bg-[#092229]/20 blur-[130px] rounded-full -z-10 pointer-events-none"></div>

		<slot />
	</body>
</html>

<style is:global>
	body {
		font-family: 'Inter', sans-serif;
	}
</style>